# DigiKraft Creative Growth Audit — environment

APP_NAME=DigiKraft · Creative Growth Audit
BRAND_SHORT=DigiKraft
LANDING_KICKER=Money Expo India 2026

# Public site URL (used for same-origin checks behind reverse proxies / Hostinger)
# Example: https://your-app.hostingersite.com
APP_URL=

# Optional comma-separated extra origins allowed to call mutating APIs
# ALLOWED_ORIGINS=https://audit.example.com,https://www.example.com

# Optional shared passcode. Empty = open tool.
PASSCODE=

# iron-session cookie secret (min 32 characters) — required in production
SESSION_SECRET=change-me-to-a-long-random-string-32chars

# Database: sqlite (default) or mysql
DB_DRIVER=sqlite
# Leave empty to auto-create storage/audits-<random>.sqlite
SQLITE_PATH=
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_NAME=
# MYSQL_USER=
# MYSQL_PASS=
# MYSQL_CHARSET=utf8mb4

# Crawler
CRAWL_MAX_PAGES=8
CRAWL_TIMEOUT=12
CRAWL_CONNECT_TIMEOUT=6
CRAWL_MAX_BYTES=2500000
CRAWL_MAX_REDIRECTS=4
CRAWL_USER_AGENT=DigiKraftAuditBot/1.0 (+https://digikraft.in; creative growth audit)
CRAWL_OBEY_ROBOTS=true
CRAWL_ALLOW_PRIVATE_HOSTS=false

# Screenshots (headless Chromium renders the page the audit read)
SHOT_ENABLED=true
SHOT_TIMEOUT=15
SHOT_DESKTOP_WIDTH=1440
SHOT_DESKTOP_HEIGHT=900
SHOT_MOBILE_WIDTH=390
SHOT_MOBILE_HEIGHT=844
# Full-page captures are cropped to this height so a very long page cannot
# produce an enormous image.
SHOT_MAX_FULL_HEIGHT=6000
SHOT_QUALITY=78
SHOT_KEEP_HOURS=720
# Override only if you ship your own Chromium instead of the bundled one.
# CHROMIUM_PATH=/usr/bin/chromium

# Uploads
UPLOAD_MAX_BYTES=20971520
UPLOAD_EXTENSIONS=pdf,docx,pptx,txt,md,html,htm
UPLOAD_KEEP_HOURS=24

# Wall-clock budget for a single API step (seconds)
STEP_BUDGET=20

# Server log verbosity: debug | info | warn | error
LOG_LEVEL=info

# Abuse guard per client IP
RATE_LIMIT_AUDITS_PER_HOUR=30

# Optional Google PageSpeed Insights key
PSI_API_KEY=
